# Conuco (petiht.com/conuco) — static PWA. Firebase handles accounts, data and AI.
Options -Indexes
DirectoryIndex index.html

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(self), microphone=(self), geolocation=(self)"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://www.googletagmanager.com https://www.google.com https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: blob: https://tile.openstreetmap.org https://www.google-analytics.com https://www.googletagmanager.com https://www.gstatic.com https://*.gstatic.com https://*.googleusercontent.com; connect-src 'self' data: blob: https://*.googleapis.com https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://www.google.com https://api.open-meteo.com https://geocoding-api.open-meteo.com; frame-src https://www.google.com https://recaptcha.google.com https://conuco-farm.firebaseapp.com; worker-src 'self'; manifest-src 'self'; media-src 'self' blob:; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'none'"
  <FilesMatch "\.(js|css|svg|png|jpg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(sw\.js|.*\.html|manifest\.webmanifest|samples\.json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

AddType application/manifest+json .webmanifest
AddType application/vnd.android.package-archive .apk

<FilesMatch "\.(md|map|mjs)$">
  Require all denied
</FilesMatch>
